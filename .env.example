# ---------------------------------------------------------------------------
# ShadowChat — variables d'environnement (copier vers `.env`, jamais committé)
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Porto-Novo

# Base de données PostgreSQL (utilisée si définie, sinon SQLite en dev)
# Forme courte :
DATABASE_URL=postgres://shadowchat:shadowchat@localhost:5432/shadowchat
# Ou variables dédiées (alternative à DATABASE_URL) :
# DB_ENGINE=postgres
# DB_NAME=shadowchat
# DB_USER=shadowchat
# DB_PASSWORD=shadowchat
# DB_HOST=localhost
# DB_PORT=5432

# Redis (cache, WebSockets Channels, tâches légères)
REDIS_URL=redis://localhost:6379/0

# CORS / CSRF — origines du frontend, séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Derrière un reverse proxy TLS (Nginx/Traefik) : true
DJANGO_TRUST_PROXY=false

# Stockage des médias (avatars, pièces jointes)
DJANGO_MEDIA_ROOT=./media
# Stockage objet (filesystem | s3 | r2 | minio)
STORAGE_BACKEND=filesystem
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=shadowchat-media
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com   # R2 / MinIO
# AWS_QUERYSTRING_AUTH=true
# STORAGE_MEDIA_URL=/media/

# Observabilité
# SENTRY_DSN=https://<key>@sentry.example.com/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_JSON=true

# E-mail (SMTP en production ; console par défaut en dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_FROM=ShadowChat <no-reply@example.com>

# Comportement
GROUP_INVITE_LINK_TTL_HOURS=24
ONLINE_WINDOW_SECONDS=60
PUBLIC_SITE_URL=

# Frontend (build Vite) : laisser vide quand l'API est servie sous le même domaine
VITE_API_URL=
